{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bixio-landing",
  "compatibility_date": "2026-08-09",

  // Cloudflare tiene el "Build command" vacío y despliega con
  // `npx wrangler deploy`; este hook hace que el propio deploy genere out/.
  "build": {
    "command": "npm run build"
  },

  // El sitio sigue siendo el export estático de Next. El Worker existe solo
  // para las cuatro rutas de `run_worker_first`: el resto de peticiones ni
  // llegan a ejecutarlo, las sirve directamente el binding de assets.
  "main": "./src/worker.ts",

  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    // Next genera out/404.html; Cloudflare lo sirve en rutas desconocidas.
    "not_found_handling": "404-page",
    // /admin va aquí porque es la única forma de que esté protegido: lo que
    // sirve el binding de assets no ejecuta el Worker, y por tanto no
    // comprueba ninguna sesión.
    "run_worker_first": ["/api/*", "/admin", "/admin/*", "/trasteros", "/sitemap.xml", "/robots.txt"]
  },

  "observability": {
    "enabled": true
  },

  // Sin esto, cada deploy borra las variables y secretos añadidos a mano
  // desde el dashboard de Cloudflare (Settings → Variables and secrets) que
  // no estén declarados aquí — es el caso de PLAUSIBLE_SHARE_URL (ver
  // src/env.ts): va como secreto y no como var de este archivo a propósito,
  // porque lleva su propio `?auth=` y no es algo para dejar en texto plano
  // en git. `keep_vars` le dice a Wrangler que no los toque.
  "keep_vars": true,

  // Los leads de las tres fuentes de captación y la cuenta del panel
  // (`admin_user`, ver migrations/0003_admin_user.sql) viven aquí. Sin este
  // binding, /api/lead vuelca a Workers Logs y /admin responde 503 en vez de
  // fallar. Migraciones: `npx wrangler d1 migrations apply bixio-leads --remote`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bixio-leads",
      "database_id": "cdffdb9e-af1e-400b-a408-af3897cb9f64",
      "migrations_dir": "./migrations"
    }
  ]
}
