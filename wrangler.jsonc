{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bixio-landing",
  "compatibility_date": "2026-08-09",

  // Cloudflare tiene el "Build command" vacío y despliega con
  // `npx wrangler deploy`; este hook hace que el propio deploy genere out/.
  "build": {
    "command": "npm run build"
  },

  // El sitio sigue siendo el export estático de Next. El Worker existe solo
  // para las cuatro rutas de `run_worker_first`: el resto de peticiones ni
  // llegan a ejecutarlo, las sirve directamente el binding de assets.
  "main": "./src/worker.ts",

  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    // Next genera out/404.html; Cloudflare lo sirve en rutas desconocidas.
    "not_found_handling": "404-page",
    // /admin va aquí porque es la única forma de que esté protegido: lo que
    // sirve el binding de assets no ejecuta el Worker, y por tanto no
    // comprueba ninguna sesión.
    "run_worker_first": ["/api/*", "/admin", "/admin/*", "/trasteros", "/sitemap.xml", "/robots.txt"]
  },

  "observability": {
    "enabled": true
  }

  // ---------------------------------------------------------------------
  // Los secretos del panel (ADMIN_EMAIL, ADMIN_PASSWORD_HASH y
  // ADMIN_SESSION_SECRET) NO van aquí: este archivo está en el repo. Se
  // ponen con `npx wrangler secret put …`, ver README, "Panel de leads".
  //
  // TODO(d1): leads de las tres fuentes de captación.
  //
  //   npx wrangler d1 create bixio-leads
  //
  // Pega el `database_id` que devuelve, descomenta este bloque y aplica la
  // migración:
  //
  //   npx wrangler d1 migrations apply bixio-leads --remote
  //
  // Hasta entonces el endpoint responde OK y vuelca cada lead a Workers Logs
  // (observability está activado arriba), así que no se pierde ninguno, y el
  // panel de /admin lo dice en vez de fallar.
  //
  // "d1_databases": [
  //   {
  //     "binding": "DB",
  //     "database_name": "bixio-leads",
  //     "database_id": "<pegar aquí>",
  //     "migrations_dir": "./migrations"
  //   }
  // ]
}
